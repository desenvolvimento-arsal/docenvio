# Porta do servidor
PORT=3000

# ------------------------------------------------------------------
# Evolution API (WhatsApp). Deixe em branco para usar o MODO SIMULAÇÃO.
# Preencha os 3 valores para enviar de verdade pela Evolution API.
# ------------------------------------------------------------------
# EVOLUTION_API_URL=https://sua-evolution.com
# EVOLUTION_API_KEY=sua-api-key
# EVOLUTION_INSTANCE=nome-da-instancia

# Força o resultado no modo simulação (opcional): success | fail
# MOCK_FORCE=success
